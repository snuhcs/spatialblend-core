common --enable_platform_specific_config
common: --per_file_copt=-third_party/.*,-external/.*

# Suppress warnings from external repositories
common --ui_event_filters=-warning
common --output_filter='^//'

common:macos --cxxopt=-std=c++17
common:macos --host_cxxopt=-std=c++17
# Xcode 26 / clang 21 hermeticity workarounds:
#  -layering_check : abseil emits `#include <variant>` from a module that
#                    doesn't export it, tripping the layering check.
#  spawn_strategy=local : the sandbox flags clang's resource-dir builtin
#                    headers as absolute-path inclusions and fails the build.
common:macos --features=-layering_check
common:macos --spawn_strategy=local
# Deployment target of the macOS binaries (LC_BUILD_VERSION minos). Without it the dylib takes the SDK's version
# (26.x on Xcode 26) and refuses to load on older macOS. 11.0 matches the Unity app's macOS target.
common:macos --macos_minimum_os=11.0

common:linux --cxxopt=-std=c++17
common:linux --host_cxxopt=-std=c++17

common:windows --cxxopt=/std:c++17
common:windows --host_cxxopt=/std:c++17
common:windows --cxxopt=/utf-8
common:windows --host_cxxopt=/utf-8
common:windows --copt=/D_USE_MATH_DEFINES
common:windows --cxxopt=/D_USE_MATH_DEFINES
common:windows --host_cxxopt=/D_USE_MATH_DEFINES
common:windows --define=protobuf_allow_msvc=true
common:windows --action_env=BAZEL_SH="C:/Program Files/Git/bin/bash.exe"
# common:windows --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows-clang-cl --extra_execution_platforms=//bazel:x64_windows-clang-cl

# Windows debug configuration to generate PDB files
common:windows:debug --cxxopt=/Zi
common:windows:debug --cxxopt=/FS
common:windows:debug --linkopt=/DEBUG
common:windows:debug --linkopt=/INCREMENTAL:NO

common -c opt
common --platform_suffix=opt
common --strip=always

common:debug -c dbg
common:debug --platform_suffix=debug
common:debug --strip=never

common:visionos --apple_platform_type=visionos
common:visionos --platforms=//bazel:visionos_arm64

common:android --platforms=//bazel:android_arm64
common:android --extra_toolchains=@androidndk//:all
common:android --features=-proto_one_output_per_message

# Local overrides (not checked in)
try-import %workspace%/.bazelrc.user
