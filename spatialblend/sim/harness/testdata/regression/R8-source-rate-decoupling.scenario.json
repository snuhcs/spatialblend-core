{
  "schema_version": "1.0",
  "id": "R8-source-rate-decoupling",
  "tier": "T2",
  "regime": "jointly_feasible",
  "verify_by": ["bounds"],

  "spaces": [
    {
      "id": "A", "role": "source",
      "walkable": [[0, 0], [20, 0], [20, 20], [0, 20]],
      "elements": [
        {
          "tag": "obj", "shared_id": 300, "parent": "room",
          "transform": {"pos": [10, 10, 0], "yaw": 0.0},
          "footprint": {"kind": "box", "size": [2, 2, 2]},
          "propagate": true
        }
      ]
    },
    {
      "id": "B", "role": "target",
      "walkable": [[0, 0], [20, 0], [20, 20], [0, 20]],
      "elements": [
        {
          "tag": "obj", "shared_id": 300, "parent": "room",
          "transform": {"pos": [10, 10, 0], "yaw": 0.0},
          "footprint": {"kind": "box", "size": [2, 2, 2]},
          "propagate": true
        }
      ]
    }
  ],

  "identity": {
    "share_from": "A",
    "expect": [
      {"shared_id": 300, "resolution": "link_to_existing"},
      {"shared_id": 9001, "resolution": "add_as_new"}
    ],
    "mismatched_ids": false
  },

  "actors": [
    {
      "id": "user", "space": "A", "shared_id": 9001,
      "anchors": [{"name": "root", "offset": [0, 0, 0]}],
      "bindings": [{"anchor": "root", "kernel": "spacing"}],
      "start": [2, 2, 0.7854]
    }
  ],

  "behavior": {
    "kind": "script",
    "script": [
      {"op": "approach", "tag": "obj", "distance": 1.1, "duration": 3.0}
    ]
  },

  "network": {"mode": "loopback", "latency_ms": 50, "jitter_ms": 10, "drop_rate": 0.6, "reorder": true},
  "core": {"referent_resolve": "linker", "weight_smoothing": 0.25, "min_move": 0.0, "min_yaw": 0.0,
           "policy": "progressive", "controller": {"v_max": 1.4, "w_max": 2.0}},

  "expect": [
    {"check": "R8.source_rate_decoupling.smooth_despite_dropped_updates", "eps": 0.0}
  ]
}
