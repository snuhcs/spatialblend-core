"""Bazel rules for running tests on Android devices via ADB.

This module provides rules and macros for building and running native C++ tests
on Android devices using ADB (Android Debug Bridge).

Usage:
    # In your BUILD file:
    load("//bazel:adb_test.bzl", "adb_test", "spatialblend_adb_test")

    # Create an ADB test from an existing cc_test target
    adb_test(
        name = "my_test_adb",
        test = ":my_test",
    )

    # Or use the combined macro that creates both cc_test and adb_test
    spatialblend_adb_test(
        name = "my_test",
        srcs = ["my_test.cc"],
        deps = ["@googletest//:gtest_main"],
    )

To run tests:
    # Build for Android (auto-configured by rule transition)
    bazel build //path:my_test_adb

    # Run on device (requires connected device)
    bazel run //path:my_test_adb
"""

def _spatialblend_test_cxxopts():
    return ["-DSPATIALBLEND_TEST"]

def _spatialblend_linkopts_unstripped():
    return select({
        "@platforms//os:android": [
            "-lc++_static",
            "-lc++abi",
            "-llog",
            "-lm",
            "-lc",
            "-latomic",
            "-ldl",
            "-Wl,--no-export-dynamic",
            "-Wl,--gc-sections",
            "-Wl,--as-needed",
        ],
        "//conditions:default": [],
    })

def _spatialblend_symbol_opts():
    return select({
        "//conditions:default": [],
    })

def _spatialblend_linkopts():
    return _spatialblend_linkopts_unstripped() + _spatialblend_symbol_opts()

def _android_cfg_transition_impl(settings, attr):
    _ = settings
    _ = attr
    features = settings["//command_line_option:features"]
    if "-proto_one_output_per_message" not in features:
        features = features + ["-proto_one_output_per_message"]
    return {
        "//command_line_option:platforms": [Label("//bazel:android_arm64")],
        "//command_line_option:extra_toolchains": ["@androidndk//:all"],
        "//command_line_option:features": features,
    }

_android_cfg_transition = transition(
    implementation = _android_cfg_transition_impl,
    inputs = ["//command_line_option:features"],
    outputs = [
        "//command_line_option:platforms",
        "//command_line_option:extra_toolchains",
        "//command_line_option:features",
    ],
)

def _adb_test_impl(ctx):
    """Implementation of the adb_test rule."""
    test_target = ctx.attr.test[0]
    test_binary = test_target[DefaultInfo].files_to_run.executable

    # Create wrapper script
    wrapper_script = ctx.actions.declare_file(ctx.label.name + "_adb_wrapper.sh")

    # Get the path to the test runner script
    runner_script = ctx.file._runner

    wrapper_content = """#!/bin/bash
# ADB Test Wrapper for {name}
# Auto-generated by Bazel adb_test rule

set -e

# Find runfiles directory - use environment variable if set by Bazel
if [ -n "${{RUNFILES_DIR:-}}" ]; then
    # RUNFILES_DIR is set by Bazel test runner
    :
elif [ -n "${{RUNFILES_MANIFEST_FILE:-}}" ]; then
    RUNFILES_DIR="${{RUNFILES_MANIFEST_FILE%.runfiles_manifest}}.runfiles"
else
    # Fallback: compute from script location
    RUNFILES_DIR="${{BASH_SOURCE[0]}}.runfiles"
    if [ ! -d "$RUNFILES_DIR" ]; then
        RUNFILES_DIR="$0.runfiles"
    fi
fi

# Get workspace name
WORKSPACE_NAME="{workspace_name}"

# Path to the test binary
TEST_BINARY="$RUNFILES_DIR/$WORKSPACE_NAME/{test_binary_path}"
RUNNER_SCRIPT="$RUNFILES_DIR/$WORKSPACE_NAME/{runner_script_path}"

# Verify files exist
if [ ! -f "$TEST_BINARY" ]; then
    echo "ERROR: Test binary not found: $TEST_BINARY"
    echo "Looking in: $RUNFILES_DIR"
    ls -la "$RUNFILES_DIR" 2>/dev/null || true
    exit 1
fi

if [ ! -f "$RUNNER_SCRIPT" ]; then
    echo "ERROR: Runner script not found: $RUNNER_SCRIPT"
    exit 1
fi

# Export any additional environment variables
{env_exports}

# Run the test
exec bash "$RUNNER_SCRIPT" "$TEST_BINARY" {test_args} "$@"
""".format(
        name = ctx.label.name,
        workspace_name = ctx.workspace_name,
        test_binary_path = test_binary.short_path,
        runner_script_path = runner_script.short_path,
        env_exports = "\n".join([
            'export {}="{}"'.format(k, v)
            for k, v in ctx.attr.env.items()
        ]),
        test_args = " ".join(ctx.attr.test_args),
    )

    ctx.actions.write(
        output = wrapper_script,
        content = wrapper_content,
        is_executable = True,
    )

    # Collect runfiles
    runfiles = ctx.runfiles(
        files = [test_binary, runner_script],
        transitive_files = depset(
            transitive = [
                test_target[DefaultInfo].default_runfiles.files,
            ],
        ),
    )

    return [
        DefaultInfo(
            executable = wrapper_script,
            runfiles = runfiles,
        ),
    ]

adb_test = rule(
    implementation = _adb_test_impl,
    attrs = {
        "test": attr.label(
            doc = "The cc_test target to run on Android device",
            mandatory = True,
            executable = True,
            cfg = _android_cfg_transition,
        ),
        "test_args": attr.string_list(
            doc = "Additional arguments to pass to the test binary",
            default = [],
        ),
        "env": attr.string_dict(
            doc = "Additional environment variables for the test",
            default = {},
        ),
        "_runner": attr.label(
            default = "//tools:adb_test_runner",
            allow_single_file = True,
        ),
        "_allowlist_function_transition": attr.label(
            default = "@bazel_tools//tools/allowlists/function_transition_allowlist",
        ),
    },
    executable = True,
    test = True,
    doc = """Runs a cc_test on an Android device via ADB.

This rule wraps an existing cc_test target and creates a test that will
push the binary to a connected Android device and execute it there.

Prerequisites:
- Android device connected via ADB
- Test target wrapped by this rule (Android config applied automatically)
- ADB available in PATH
""",
)

def spatialblend_adb_test(name, srcs, deps = [], data = [], args = [], env = {}, tags = [], **kwargs):
    """Creates both a cc_test and an adb_test for Android device testing.

    This macro creates two targets:
    - {name}: A standard cc_test that can run on the host
    - {name}_adb: An adb_test that runs on a connected Android device

    Args:
        name: Base name for the test targets
        srcs: Source files for the test
        deps: Dependencies for the test
        data: Data files for the test
        args: Arguments to pass to the test
        env: Environment variables for the ADB test
        tags: Tags for the test targets
        **kwargs: Additional arguments passed to cc_test
    """

    # Create the standard cc_test
    native.cc_test(
        name = name,
        srcs = srcs,
        deps = deps,
        data = data,
        copts = _spatialblend_test_cxxopts(),
        linkopts = _spatialblend_linkopts(),
        tags = tags,
        **kwargs
    )

    # Create the ADB test wrapper
    adb_test(
        name = name + "_adb",
        test = ":" + name,
        test_args = args,
        env = env,
        tags = tags + ["manual", "android", "adb"],
    )

def adb_test_suite(name, tests, tags = []):
    """Creates a test suite of ADB tests.

    Args:
        name: Name of the test suite
        tests: List of test labels to include
        tags: Additional tags for all tests
    """
    native.test_suite(
        name = name,
        tests = [t + "_adb" if not t.endswith("_adb") else t for t in tests],
        tags = tags + ["android", "adb"],
    )

def _adb_binary_impl(ctx):
    """Implementation of the adb_binary rule for running cc_binary on Android."""
    binary_target = ctx.attr.binary[0]
    binary = binary_target[DefaultInfo].files_to_run.executable
    runner_script = ctx.file._runner

    wrapper_script = ctx.actions.declare_file(ctx.label.name + "_adb_wrapper.sh")
    wrapper_content = """#!/bin/bash
# ADB Binary Wrapper for {name}
# Auto-generated by Bazel adb_binary rule

set -e

if [ -n "${{RUNFILES_DIR:-}}" ]; then
    :
elif [ -n "${{RUNFILES_MANIFEST_FILE:-}}" ]; then
    RUNFILES_DIR="${{RUNFILES_MANIFEST_FILE%.runfiles_manifest}}.runfiles"
else
    RUNFILES_DIR="${{BASH_SOURCE[0]}}.runfiles"
    if [ ! -d "$RUNFILES_DIR" ]; then
        RUNFILES_DIR="$0.runfiles"
    fi
fi

WORKSPACE_NAME="{workspace_name}"
BINARY="$RUNFILES_DIR/$WORKSPACE_NAME/{binary_path}"
RUNNER_SCRIPT="$RUNFILES_DIR/$WORKSPACE_NAME/{runner_path}"

if [ ! -f "$BINARY" ]; then
    echo "ERROR: Binary not found: $BINARY"
    exit 1
fi

if [ ! -f "$RUNNER_SCRIPT" ]; then
    echo "ERROR: Runner not found: $RUNNER_SCRIPT"
    exit 1
fi

{env_exports}
exec bash "$RUNNER_SCRIPT" "$BINARY" {binary_args} "$@"
""".format(
        name = ctx.label.name,
        workspace_name = ctx.workspace_name,
        binary_path = binary.short_path,
        runner_path = runner_script.short_path,
        env_exports = "\n".join([
            'export {}="{}"'.format(k, v)
            for k, v in ctx.attr.env.items()
        ]),
        binary_args = " ".join(ctx.attr.binary_args),
    )

    ctx.actions.write(output = wrapper_script, content = wrapper_content, is_executable = True)

    runfiles = ctx.runfiles(
        files = [binary, runner_script],
        transitive_files = depset(
            transitive = [binary_target[DefaultInfo].default_runfiles.files],
        ),
    )

    return [DefaultInfo(executable = wrapper_script, runfiles = runfiles)]

adb_binary = rule(
    implementation = _adb_binary_impl,
    attrs = {
        "binary": attr.label(
            doc = "The cc_binary target to run on Android device",
            mandatory = True,
            executable = True,
            cfg = _android_cfg_transition,
        ),
        "binary_args": attr.string_list(
            doc = "Arguments to pass to the binary (e.g., --benchmark_format=console)",
            default = [],
        ),
        "env": attr.string_dict(
            doc = "Environment variables for the binary",
            default = {},
        ),
        "_runner": attr.label(
            default = "//tools:adb_test_runner",
            allow_single_file = True,
        ),
        "_allowlist_function_transition": attr.label(
            default = "@bazel_tools//tools/allowlists/function_transition_allowlist",
        ),
    },
    executable = True,
    doc = """Runs a cc_binary on an Android device via ADB (e.g., benchmarks).""",
)
