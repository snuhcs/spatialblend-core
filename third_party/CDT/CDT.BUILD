# CDT - Constrained Delaunay Triangulation
# https://github.com/artem-ogre/CDT
# License: MPL 2.0

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # MPL 2.0

cc_library(
    name = "CDT",
    hdrs = glob([
        "include/*.h",
        "include/*.hpp",
    ]),
    includes = ["include"],
    copts = [
        "-std=c++11",
    ],
)
